{
  "name": "@ficsysfr/nestjs_module_factorydrive-sftp",
  "version": "2.0.0",
  "description": "SFTP driver for @ficsysfr/nestjs_module_factorydrive",
  "repository": "https://github.com/FicSysFR/nestjs_module_factorydrive-sftp.git",
  "homepage": "https://ficsysfr.github.io/nestjs_module_factorydrive/guide/drivers",
  "bugs": {
    "url": "https://github.com/FicSysFR/nestjs_module_factorydrive-sftp/issues"
  },
  "author": "tacxou <12997062+tacxou@users.noreply.github.com> (https://github.com/tacxou)",
  "contributors": [
    {
      "name": " tacxou",
      "email": "12997062+tacxou@users.noreply.github.com",
      "url": "https://github.com/tacxou"
    },
    {
      "name": "Contributors",
      "url": "https://github.com/FicSysFR/nestjs_module_factorydrive-sftp/graphs/contributors"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "factory",
    "node",
    "nodejs",
    "disk",
    "driver",
    "bucket",
    "drive",
    "abstract",
    "abstraction",
    "nestjs",
    "storage",
    "filesystem",
    "file",
    "ssh",
    "sftp",
    "promise",
    "async",
    "spaces",
    "factorydrive"
  ],
  "scripts": {
    "prebuild": "rimraf dist && yarn typecheck",
    "build": "tsc -p tsconfig.build.json",
    "build:cpr": "cpr README.md dist/README.md && cpr LICENSE dist/LICENSE && cpr package.json dist/package.json",
    "postbuild": "yarn build:cpr",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changelog:check": "node scripts/changelog.mjs --check",
    "changelog:write": "node scripts/changelog.mjs --write",
    "release:prepare": "node scripts/release.mjs prepare",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check"
  },
  "dependencies": {
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@ficsysfr/nestjs_module_factorydrive": "npm:@tacxou/nestjs_module_factorydrive@1.2.4",
    "@types/node": "latest",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@vitest/coverage-v8": "^5.0.0",
    "cpr": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "@ficsysfr/nestjs_module_factorydrive": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "rolldown": "1.2.7"
  }
}
